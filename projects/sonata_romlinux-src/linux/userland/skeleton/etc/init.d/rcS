#!/bin/sh
# System setup, run once by init. devtmpfs is already mounted on /dev by the kernel.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o size=2m tmpfs /tmp
echo "========================================"
echo "  Sonata Linux - LiteX VexRiscv RV32IMAC"
echo "  MMU, single hart, 8 MB HyperRAM"
echo "========================================"
uname -a
echo
# A slideshow of the built-in pictures on the LCD (/usr/share/photobox). It keeps /dev/fb0 open, so the text console
# stays hidden; `killall photobox` stops it and the console comes back.
photobox 10 </dev/null >/dev/null 2>&1 &
