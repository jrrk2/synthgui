
/dts-v1/;

/ {
        compatible = "litex,lowrisc_sonata", "litex,soc";
        model = "lowrisc_sonata";
        #address-cells = <1>;
        #size-cells    = <1>;


        chosen {
            bootargs = "console=liteuart earlycon=liteuart,0xf0001000 root=mtd:rootfs rootfstype=romfs ro init=/sbin/init ip=dhcp panic=5 loglevel=8";
        };

        sys_clk: clock-50000000 {
            compatible = "fixed-clock";
            #clock-cells = <0>;
            clock-frequency  = <50000000>;
        };

        cpus {
            #address-cells = <1>;
            #size-cells    = <0>;
            timebase-frequency = <50000000>;

            CPU0: cpu@0 {
                device_type = "cpu";
                compatible = "riscv";
                riscv,isa = "rv32ima_zicsr_zifencei";
                riscv,isa-base = "rv32i";
                riscv,isa-extensions = "a", "i", "m", "zicsr", "zifencei";
                mmu-type = "riscv,sv32";
                reg = <0>;
                clock-frequency = <50000000>;
                status = "okay";

                d-cache-size = <8192>;
                d-cache-sets = <64>;
                d-cache-block-size = <64>;

                i-cache-size = <8192>;
                i-cache-sets = <64>;
                i-cache-block-size = <64>;


                tlb-split;
                d-tlb-size = <4>;
                d-tlb-sets = <4>;

                i-tlb-size = <4>;
                i-tlb-sets = <4>;


                L0: interrupt-controller {
                    #address-cells = <0>;
                    #interrupt-cells = <0x00000001>;
                    interrupt-controller;
                    compatible = "riscv,cpu-intc";
                };
            };

            CPU1: cpu@1 {
                device_type = "cpu";
                compatible = "riscv";
                riscv,isa = "rv32ima_zicsr_zifencei";
                riscv,isa-base = "rv32i";
                riscv,isa-extensions = "a", "i", "m", "zicsr", "zifencei";
                mmu-type = "riscv,sv32";
                reg = <1>;
                clock-frequency = <50000000>;
                status = "disabled";

                d-cache-size = <8192>;
                d-cache-sets = <64>;
                d-cache-block-size = <64>;

                i-cache-size = <8192>;
                i-cache-sets = <64>;
                i-cache-block-size = <64>;

                tlb-split;
                d-tlb-size = <4>;
                d-tlb-sets = <4>;

                i-tlb-size = <4>;
                i-tlb-sets = <4>;

                L1: interrupt-controller {
                    #address-cells = <0>;
                    #interrupt-cells = <0x00000001>;
                    interrupt-controller;
                    compatible = "riscv,cpu-intc";
                };
            };

            cpu-map {
                cluster0 {
                    core0 {
                        cpu = <&CPU0>;
                    };
                };
            };

        };

        memory: memory@40000000 {
            device_type = "memory";
            reg = <0x40000000 0x800000>;
            /* Full 8MB HyperRAM. M-mode stub runs from SRAM, not RAM. */
        };

        soc {
            #address-cells = <1>;
            #size-cells    = <1>;
            compatible = "simple-bus";
            interrupt-parent = <&intc0>;
            ranges;

            soc_ctrl0: soc_controller@f0000000 {
                compatible = "litex,soc-controller";
                reg = <0xf0000000 0xc>;
                status = "okay";
            };

            lintc0: clint@f0010000 {
                compatible = "riscv,clint0";
                interrupts-extended = <&L0 3 &L0 7>;
                reg = <0xf0010000 0x10000>;
                reg-names = "control";
            };

            intc0: interrupt-controller@f0c00000 {
                compatible = "sifive,fu540-c000-plic", "sifive,plic-1.0.0";
                reg = <0xf0c00000 0x400000>;
                #address-cells = <0>;
                #interrupt-cells = <1>;
                interrupt-controller;
                interrupts-extended = <&L0 11 &L0 9>;
                riscv,ndev = <32>;

            };

            liteuart0: serial@f0001000 {
                compatible = "litex,liteuart";
                reg = <0xf0001000 0x100>;
                interrupts = <1>;
                status = "okay";
            };

            lcd: display@80305000 {
                compatible = "sonata,lcdtext";
                reg = <0x80305000 0x200>;
            };

            lcdfb: framebuffer@80310000 {
                compatible = "sonata,lcdfb";
                reg = <0x80310000 0xa000>, <0x80305000 0x200>;
            };

            spi_eth: spi@80302000 {
                compatible = "lowrisc,opentitan-spi";
                reg = <0x80302000 0x2000>;
                #address-cells = <1>;
                #size-cells = <0>;
                clocks = <&sys_clk>;
                status = "okay";

                ethernet@0 {
                    compatible = "micrel,ks8851";
                    reg = <0>;
                    spi-max-frequency = <12500000>;
                    interrupts = <2>;
                    interrupt-parent = <&intc0>;
                };
            };

            leds: gpio@f0002800 {
                compatible = "litex,gpio";
                reg = <0xf0002800 0x4>;
                gpio-controller;
                #gpio-cells = <2>;
                litex,direction = "out";
                litex,ngpio = <4>;
                status = "okay";
            };

            switches: gpio@f0004800 {
                compatible = "litex,gpio";
                reg = <0xf0004800 0x4>;
                gpio-controller;
                #gpio-cells = <2>;
                litex,direction = "in";
                interrupts = <4>;
                litex,ngpio = <4>;
                status = "okay";
            };

            flash@2000000 {
                compatible = "mtd-rom";
                reg = <0x02000000 0x2000000>;
                bank-width = <1>;
                #address-cells = <1>;
                #size-cells = <1>;

                kernel@0 {
                    label = "kernel";
                    reg = <0x000000 0x540000>;
                };
                opensbi@540000 {
                    label = "opensbi";
                    reg = <0x540000 0x80000>;
                };
                rootfs@5C0000 {
                    label = "rootfs";
                    reg = <0x5C0000 0x1A40000>;
                };
            };

        };

        aliases {
                serial0 = &liteuart0;
        };

};
