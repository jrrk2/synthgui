# RAM boot kernel config (non-XIP, for TFTP boot to HyperRAM)
# Usage: tinyconfig + merge this file

# Architecture - rv32ima, SMP dual-core, no FPU
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=n
CONFIG_FPU=n
CONFIG_SMP=n
CONFIG_EFI=n

# Memory (NOT XIP — runs from RAM)
CONFIG_XIP_KERNEL=n
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x40000000

# MMU
CONFIG_MMU=y

# Device tree (built-in DTB for self-relocating kernel)
CONFIG_OF=y
CONFIG_BUILTIN_DTB=y

# Serial console
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Interrupts
CONFIG_SIFIVE_PLIC=y

# CLINT timer
CONFIG_RISCV_TIMER=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_LITEX=y

# LiteX SoC
CONFIG_LITEX_SOC_CONTROLLER=y
CONFIG_LITEX_SUBREG_SIZE=4

# MTD flash (ROMFS rootfs from NOR flash)
CONFIG_MTD=y
CONFIG_MTD_ROM=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_ROMFS_FS=y
CONFIG_ROMFS_BACKED_BY_MTD=y

# Networking (for ethernet driver testing)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_OPENTITAN=y

# GPIO (needed by ks8851 driver for optional reset GPIO stub)
CONFIG_GPIOLIB=y

# KSZ8851SNL SPI ethernet
CONFIG_KS8851=y
CONFIG_NET_VENDOR_MICREL=y

# Proc/sys/devtmpfs
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# ELF/script execution
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
CONFIG_UNIX=y
