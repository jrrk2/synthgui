From 5d9c1ca009bf02cfd9a447f59fadda0a43604dca Mon Sep 17 00:00:00 2001
From: Jonathan Kimmitt <jonathan@kimmitt.co.uk>
Date: Fri, 20 Nov 2026 19:07:51 +0000
Subject: [PATCH] map: pins from --map-only-pins are not replaced by the timing
 file's

With both --map-only-pins and --map-only-sdc given, the pin assignments
read from the first were overwritten by those of the second, so a
constraint file with timing commands only made every port fail the
check for a package pin.
---
 src/V3EmitMap.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/V3EmitMap.cpp b/src/V3EmitMap.cpp
index 785a7d7..c7a2db9 100644
--- a/src/V3EmitMap.cpp
+++ b/src/V3EmitMap.cpp
@@ -1104,9 +1104,11 @@ public:
                 std::string err;
                 if (!V3MapSdcRead(v3Global.opt.mapOnlySdc(), sdc, err))
                     v3fatal("Synthesis: " << err);
-                m_pinPorts = sdc.pinPorts;
-                m_pinFile = sdc.filename;
-                m_pinWildcard = sdc.pinWildcard;
+                if (v3Global.opt.mapOnlyPins().empty()) {  // else the pins have a file of their own
+                    m_pinPorts = sdc.pinPorts;
+                    m_pinFile = sdc.filename;
+                    m_pinWildcard = sdc.pinWildcard;
+                }
             }
             V3MapTiming::Options to;
             to.defaultPeriod = v3Global.opt.mapOnlyPeriod();
-- 
2.53.0

