         size_t end = line.size();
         while (end > 0 && (line[end - 1] == ' ' || line[end - 1] == '\t')) --end;
@@ -74,6 +118,7 @@ std::string filterSdc(std::istream& in, std::set<std::string>& skipped) {
             out += stmt + "\n";
