{
  "blackboxes": [
    "BUFG",
    "FDCE",
    "FDPE",
    "GTXE2_CHANNEL",
    "IBUFDS",
    "IBUFDS_GTE2",
    "IDELAYCTRL",
    "IDELAYE2",
    "IOBUF",
    "IOBUFDS",
    "ISERDESE2",
    "MMCME2_ADV",
    "OBUFDS",
    "ODELAYE2",
    "OSERDESE2"
  ],
  "capacity": {
    "BUFG": 32,
    "DSP": 2800,
    "FF": 607200,
    "IO": 700,
    "LUT": 303600,
    "LUTRAM": 130800,
    "RAMB36": 1030
  },
  "convert": "{root}/xc7/convert.py",
  "defines": [
    "SYNTHESIS"
  ],
  "device": "xc7vx485t",
  "family": "virtex7",
  "incdirs": [
    "{root}/projects/vc707_romlinux-src"
  ],
  "lvs_equiv": "{builds}/fasm2netlist/lvs_equiv",
  "name": "vc707 LiteX Linux from ROM",
  "nextpnr": "{builds}/nextpnr/nextpnr-himbaechel",
  "nextpnr_flags": "--placer-heap-timingweight 100 --placer-heap-congestion-spread -o 'delay-matrix={root}/projects/vc707_romlinux-src/delay-matrix-xc7vx485t.txt' --router router2 -o hold-fix=8 --timing-allow-fail",
  "openfpgaloader": "{prefix}/bin/openFPGALoader",
  "options": {
    "pnr.allow_fail": "1",
    "pnr.cong_spread": "1",
    "pnr.delay_matrix": "{root}/projects/vc707_romlinux-src/delay-matrix-xc7vx485t.txt",
    "pnr.hold_fix": "8",
    "pnr.router": "router2",
    "pnr.timingweight": "100",
    "pnr.clock_tree": "on",
    "pnr.bram_place": "on",
    "synth.warn.WIDTHTRUNC": "1",
    "synth.warn.WIDTHEXPAND": "1",
    "synth.warn.MULTIDRIVEN": "1",
    "synth.warn.BLKANDNBLK": "1",
    "synth.warn.PINMISSING": "1",
    "synth.warn.UNOPTFLAT": "1",
    "synth.warn.TIMESCALEMOD": "1",
    "synth.warn.SPECIFYIGN": "1"
  },
  "part": "xc7vx485tffg1761-2",
  "prjxray_db": "{deps}/prjxray-db",
  "python": "{builds}/venv/bin/python",
  "sources": [
    "{root}/projects/vc707_romlinux-src/Ram_1w_1rs_Generic.v",
    "{root}/projects/vc707_romlinux-src/VexRiscvLitexSmpCluster_Cc1_Iw32Is4096Iy1_Dw32Ds4096Dy1_ITs4DTs4_Ood_Wm.v",
    "{root}/projects/vc707_romlinux-src/liteeth_sgmii_phy.v",
    "{root}/projects/vc707_romlinux-src/xilinx_vc707.v"
  ],
  "srcdir": "{root}/projects/vc707_romlinux-src",
  "sta": "{prefix}/bin/sta",
  "steps": [
    {
      "command": "MEM_INIT_DIR={srcdir} VERILATOR_ROOT={verilator_root} {verilator} -Wno-fatal --quiet {defines} {incdirs} --top-module {top} --struct-only-report {blackboxes} --map-only-output {json} --map-only-verilog {work}/{top}_mapped.v --map-only-edif {edif} --Mdir {work}/obj {xilinx_stubs} {sources}",
      "id": "synth",
      "label": "Synthesize"
    },
    {
      "command": "{nextpnr} --device {part} -o xdc={xdc} --json {json} -o fasm={fasm} -o placement={placement} --write {routed} --sdf {sdf} {nextpnr_flags}",
      "id": "pnr",
      "label": "Place & Route"
    },
    {
      "id": "fom",
      "label": "Block RAM merit",
      "command": "{python} {bram_fom} --netlist {json} --tilegrid {prjxray_db}/{family}/{device}/tilegrid.json --delay-matrix {delay_matrix_file} {top}={placement}"
    },
    {
      "command": "python3 {sta_prep} --json {routed} --sdf {sdf} --log {work}/pnr.log --out {work}/sta && cd {work}/sta && {sta} -no_splash -exit sta.tcl",
      "id": "sta",
      "label": "OpenSTA"
    },
    {
      "command": "mkdir -p {work}/lvs && {tileverilog} --fasm {fasm} --db {prjxray_db}/{family} --device {device} --xdc {xdc} --part {part} --out {work}/lvs/fabric.v --model-out {work}/lvs/tile_model.v && {tileverilog} --fasm {fasm} --db {prjxray_db}/{family} --device {device} --xdc {xdc} --part {part} --placement {placement} --gold-json {json} --out {work}/lvs/fabric_named.v && {lvs_equiv} --gold {json} --gold-top {top} --gate {work}/lvs/fabric.v --gate-top fabric --placement {placement} --db {prjxray_db}/{family} --device {device} --quiet",
      "id": "lvs",
      "label": "LVS"
    },
    {
      "command": "{python} {convert} --arch xilinx --family xc7 --part {part} --db {prjxray_db} --fasm {fasm} --output {bit}",
      "id": "bit",
      "label": "Bitstream"
    },
    {
      "command": "{openfpgaloader} --cable digilent --freq 15000000 {bit}",
      "id": "program",
      "label": "Program"
    }
  ],
  "tileverilog": "{builds}/fasm2netlist/tileverilog",
  "top": "xilinx_vc707",
  "verilator": "{prefix}/bin/verilator",
  "verilator_root": "{prefix}/share/verilator",
  "work": "~/synthgui-work/vc707_romlinux",
  "xdc": "{root}/projects/vc707_romlinux-src/xilinx_vc707.xdc",
  "xilinx_stubs": "{root}/xc7/cells_sim.v {root}/xc7/cells_xtra.v",
  "bram_fom_budget": "6100/5400"
}
