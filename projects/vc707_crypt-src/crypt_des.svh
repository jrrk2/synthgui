function automatic logic [1:32] des_f(input logic [1:32] r, input logic [1:48] k);
    logic [1:48] x;
    x = des_e(r) ^ k;
    return des_p({des_s1(x[1:6]), des_s2(x[7:12]), des_s3(x[13:18]), des_s4(x[19:24]), des_s5(x[25:30]), des_s6(x[31:36]), des_s7(x[37:42]), des_s8(x[43:48])});
endfunction
// sixteen rounds in IP's domain: L|R in, R16|L16 out
function automatic logic [1:64] des16(input logic [1:64] lr, input logic [1:56] cd);
    logic [1:32] l, r, t;
    l = lr[1:32];
    r = lr[33:64];
    t = l ^ des_f(r, des_k1(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k2(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k3(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k4(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k5(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k6(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k7(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k8(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k9(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k10(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k11(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k12(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k13(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k14(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k15(cd)); l = r; r = t;
    t = l ^ des_f(r, des_k16(cd)); l = r; r = t;
    return {r, l};
endfunction
