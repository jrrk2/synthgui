{
  "name": "vc707 ethmin (netboot loader)",
  "top": "vc707_ethmin_vm",
  "work": "~/synthgui-work/vc707_ethmin",
  "device": "xc7vx485t",
  "part": "xc7vx485tffg1761-2",
  "xdc": "{root}/projects/vc707_ethmin-src/vc707_ethmin_vm_open.xdc",
  "srcdir": "{root}/projects/vc707_ethmin-src",
  "sources": [
    "{root}/projects/vc707_ethmin-src/ocaml4142_vm_rtl.sv",
    "{root}/projects/vc707_ethmin-src/program_bram.v",
    "{root}/projects/vc707_ethmin-src/data_bram.v",
    "{root}/projects/vc707_ethmin-src/vm_trace.v",
    "{root}/projects/vc707_ethmin-src/tdp_ram32.v",
    "{root}/projects/vc707_ethmin-src/ethmin_vm_core.v",
    "{root}/projects/vc707_ethmin-src/vc707_ethmin_vm.v",
    "{root}/projects/vc707_ethmin-src/sd_wrap.v",
    "{root}/projects/vc707_ethmin-src/sd_top.sv",
    "{root}/projects/vc707_ethmin-src/sd_data_serial_host.sv",
    "{root}/projects/vc707_ethmin-src/sd_cmd_serial_host.v",
    "{root}/projects/vc707_ethmin-src/sd_crc_7.v",
    "{root}/projects/vc707_ethmin-src/sd_crc_16.v",
    "{root}/projects/vc707_ethmin-src/sd_clock_divider.v",
    "{root}/projects/vc707_ethmin-src/fpu_hardfloat.v",
    "{root}/projects/vc707_ethmin-src/recode64.v",
    "{root}/projects/vc707_ethmin-src/hardfloat.v",
    "{root}/projects/vc707_ethmin-src/simpleuart.v",
    "{root}/projects/vc707_ethmin-src/liteeth_sgmii_phy.v",
    "{root}/projects/vc707_ethmin-src/eth_mac_1g.sv",
    "{root}/projects/vc707_ethmin-src/axis_gmii_rx.sv",
    "{root}/projects/vc707_ethmin-src/axis_gmii_tx.sv",
    "{root}/projects/vc707_ethmin-src/rgmii_lfsr.sv",
    "{root}/projects/vc707_ethmin-src/eth_lutram_fifo.sv",
    "{root}/projects/vc707_ethmin-src/eth_stream_dma.sv",
    "{root}/projects/vc707_ethmin-src/eth_gmii_retime256.sv",
    "{root}/projects/vc707_ethmin-src/eth_pkt_buf256.sv",
    "{root}/projects/vc707_ethmin-src/sgmii_soc_liteeth.sv",
    "{root}/projects/vc707_ethmin-src/clkgen_vc707.sv"
  ],
  "incdirs": [
    "{root}/projects/vc707_ethmin-src"
  ],
  "defines": [
    "SYNTHESIS",
    "SYS_DIV=20.000",
    "CLK_HZ=50000000",
    "BUILD_ID=32'h229b9379"
  ],
  "blackboxes": [
    "BUFG",
    "FDCE",
    "GTXE2_CHANNEL",
    "IBUFDS",
    "IBUFDS_GTE2",
    "IOBUF",
    "OBUFT",
    "MMCME2_ADV",
    "RAMB36E1",
    "IBUF",
    "OBUF"
  ],
  "verilator": "{prefix}/bin/verilator",
  "verilator_root": "{prefix}/share/verilator",
  "xilinx_stubs": "{root}/xc7/cells_sim.v {root}/xc7/cells_xtra.v",
  "nextpnr": "{builds}/nextpnr/nextpnr-himbaechel",
  "nextpnr_flags": "--router router2 --timing-allow-fail -o hold-fix --placer-heap-timingweight 60 --placer-heap-congestion-spread",
  "prjxray_db": "{deps}/prjxray-db",
  "lvs_equiv": "{builds}/fasm2netlist/lvs_equiv",
  "sta": "{prefix}/bin/sta",
  "openfpgaloader": "{prefix}/bin/openFPGALoader",
  "steps": [
    {
      "id": "synth",
      "label": "Synthesize",
      "command": "MEM_INIT_DIR={srcdir} VERILATOR_ROOT={verilator_root} {verilator} -Wno-fatal --quiet {defines} {incdirs} --top-module {top} --struct-only-report {blackboxes} --map-only-output {json} --map-only-verilog {work}/{top}_mapped.v --map-only-edif {edif} --Mdir {work}/obj {xilinx_stubs} {sources}"
    },
    {
      "id": "pnr",
      "label": "Place & Route",
      "command": "{nextpnr} --device {part} -o xdc={xdc} --json {json} -o fasm={fasm} -o placement={placement} --write {routed} --sdf {sdf} {nextpnr_flags}"
    },
    {
      "id": "sta",
      "label": "OpenSTA",
      "command": "{sta_prep} --json {routed} --sdf {sdf} --log {work}/pnr.log --out {work}/sta && cd {work}/sta && {sta} -no_splash -exit sta.tcl"
    },
    {
      "id": "lvs",
      "label": "LVS",
      "command": "mkdir -p {work}/lvs && {tileverilog} --fasm {fasm} --db {prjxray_db}/{family} --device {device} --xdc {xdc} --part {part} --out {work}/lvs/fabric.v --model-out {work}/lvs/tile_model.v && {tileverilog} --fasm {fasm} --db {prjxray_db}/{family} --device {device} --xdc {xdc} --part {part} --placement {placement} --gold-json {json} --out {work}/lvs/fabric_named.v && {lvs_equiv} --gold {json} --gold-top {top} --gate {work}/lvs/fabric.v --gate-top fabric --placement {placement} --db {prjxray_db}/{family} --device {device} --quiet"
    },
    {
      "id": "bit",
      "label": "Bitstream",
      "command": "{fasm2frames} --part {part} --db-root {prjxray_db}/{family} {fasm} {work}/{top}.frames && {frames2bit} --part_file {prjxray_db}/{family}/{part}/part.yaml --part_name {part} --frm_file {work}/{top}.frames --output_file {bit}"
    },
    {
      "id": "program",
      "label": "Program",
      "command": "{openfpgaloader} --cable digilent --freq 15000000 {bit}"
    }
  ],
  "capacity": {
    "LUT": 303600,
    "FF": 607200,
    "RAMB36": 1030,
    "LUTRAM": 130800,
    "DSP": 2800,
    "IO": 700,
    "BUFG": 32
  },
  "tileverilog": "{builds}/fasm2netlist/tileverilog",
  "family": "virtex7",
  "options": {
    "synth.warn.WIDTHTRUNC": "1",
    "synth.warn.WIDTHEXPAND": "1",
    "synth.warn.MULTIDRIVEN": "1",
    "synth.warn.BLKANDNBLK": "1",
    "synth.warn.PINMISSING": "1",
    "synth.warn.UNOPTFLAT": "1",
    "synth.warn.TIMESCALEMOD": "1",
    "synth.warn.SPECIFYIGN": "1"
  }
}
