    "~/bytecode/fpga/sd-lowrisc/sd_crc_16.v",
    "~/bytecode/fpga/sd-lowrisc/sd_clock_divider.v",
    "~/bytecode/fpga/fpu-rtl/fpu_hardfloat.v",
    "~/bytecode/fpga/fpu-rtl/recode64.v",
    "~/bytecode/fpga/fpu-rtl/hardfloat.v",
    "~/bytecode/fpga/eth-rtl/simpleuart.v",
