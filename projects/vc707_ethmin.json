    "~/bytecode/fpga/eth-rtl/axis_gmii_rx.sv",
    "~/bytecode/fpga/eth-rtl/axis_gmii_tx.sv",
    "~/bytecode/fpga/eth-rtl/rgmii_lfsr.sv",
    "~/bytecode/fpga/eth-rtl/eth_lutram_fifo.sv",
    "~/bytecode/fpga/eth-rtl/eth_stream_dma.sv",
    "~/bytecode/fpga/eth-rtl/eth_gmii_retime256.sv",
    "~/bytecode/fpga/eth-rtl/eth_pkt_buf256.sv",
    "~/bytecode/fpga/eth-rtl/sgmii_soc_liteeth.sv",
    "~/bytecode/fpga/eth-rtl/clkgen_vc707.sv"
  ],
  "incdirs": [
    "~/bytecode",
    "~/bytecode/rtl_instructions",
    "~/bytecode/fpga/vc707-ethmin",
    "~/bytecode/fpga/sd-lowrisc"
  ],
  "defines": [
    "SYNTHESIS",
    "SYS_DIV=20.000",
    "CLK_HZ=50000000",
    "BUILD_ID=32'h229b9379"
  ],
  "blackboxes": [
    "BUFG",
    "FDCE",
    "GTXE2_CHANNEL",
    "IBUFDS",
    "IBUFDS_GTE2",
    "IOBUF",
    "OBUFT",
    "MMCME2_ADV",
    "RAMB36E1",
    "IBUF",
    "OBUF"
  ],
  "verilator_root": "~/verilator",
  "xilinx_stubs": "~/xc7-bitstream-tools/yosys/share/xilinx/cells_sim.v ~/xc7-bitstream-tools/yosys/share/xilinx/cells_xtra.v",
  "nextpnr": "~/bytecode-work/pinned/build/nextpnr-himbaechel",
  "nextpnr_flags": "--router router2 --timing-allow-fail -o hold-fix --placer-heap-timingweight 60 --placer-heap-congestion-spread",
  "prjxray_db": "~/bytecode-work/pinned/prjxray-db",
  "python": "~/xc7-bitstream-tools/.venv/bin/python",
  "convert": "~/xc7-bitstream-tools/scripts/convert.py",
  "yosys": "~/xc7-bitstream-tools/yosys/yosys",
  "lvs_equiv": "~/xc7-bitstream-tools/fasm2netlist/build/lvs_equiv",
  "sta": "~/OpenROAD-flow-scripts/tools/install/OpenROAD/bin/sta",
  "openfpgaloader": "~/openFPGALoader/build/openFPGALoader",
  "steps": [
    {
      "id": "synth",
      "label": "Synthesize",
      "command": "MEM_INIT_DIR={srcdir} VERILATOR_ROOT={verilator_root} {verilator_root}/bin/verilator -Wno-fatal --quiet -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-MULTIDRIVEN -Wno-BLKANDNBLK -Wno-PINMISSING -Wno-UNOPTFLAT -Wno-TIMESCALEMOD {defines} {incdirs} --top-module {top} --struct-only-report {blackboxes} --map-only-output {json} --map-only-edif {edif} --Mdir {work}/obj {xilinx_stubs} {sources}"
    },
    {
      "id": "pnr",
      "label": "Place & Route",
      "command": "{nextpnr} --device {part} -o xdc={xdc} --json {json} -o fasm={fasm} -o placement={placement} --write {routed} --sdf {sdf} {nextpnr_flags}"
    },
    {
      "id": "sta",
      "label": "OpenSTA",
      "command": "python3 {sta_prep} --json {routed} --sdf {sdf} --log {work}/pnr.log --out {work}/sta && cd {work}/sta && {sta} -no_splash -exit sta.tcl"
    },
    {
      "id": "lvs",
      "label": "LVS",
      "command": "mkdir -p {work}/lvs && {tileverilog} --fasm {fasm} --db {prjxray_db}/{family} --device {device} --xdc {xdc} --part {part} --out {work}/lvs/fabric.v --model-out {work}/lvs/tile_model.v && {tileverilog} --fasm {fasm} --db {prjxray_db}/{family} --device {device} --xdc {xdc} --part {part} --placement {placement} --gold-json {json} --out {work}/lvs/fabric_named.v && {yosys} -q -p 'read_json {json}; hierarchy -top {top}; splitnets; select {top}; write_verilog -noattr -norename -selected {work}/lvs/gold.v' && {lvs_equiv} --gold {work}/lvs/gold.v --gold-top {top} --gate {work}/lvs/fabric.v --gate-top fabric --placement {placement} --gold-json {json} --db {prjxray_db}/{family} --device {device} --quiet"
    },
    {
      "id": "bit",
      "label": "Bitstream",
      "command": "{python} {convert} --arch xilinx --family xc7 --part {part} --db {prjxray_db} --fasm {fasm} --output {bit}"
    },
    {
      "id": "program",
      "label": "Program",
      "command": "{openfpgaloader} --cable digilent --freq 15000000 {bit}"
    }
  ],
  "capacity": {
    "LUT": 303600,
    "FF": 607200,
    "RAMB36": 1030,
    "LUTRAM": 130800,
    "DSP": 2800,
    "IO": 700,
    "BUFG": 32
  },
  "tileverilog": "~/xc7-bitstream-tools/fasm2netlist/build/tileverilog",
  "family": "virtex7"
}
