{
    "blackboxes": [
        "BUFG",
        "IBUFDS",
        "MMCME2_ADV",
        "IBUF",
        "OBUF",
        "RAMB36E1"
    ],
    "capacity": {
        "BUFG": 32,
        "DSP": 2800,
        "FF": 607200,
        "IO": 700,
        "LUT": 303600,
        "LUTRAM": 130800,
        "RAMB36": 1030
    },
    "convert": "{root}/xc7/convert.py",
    "defines": [
        "SYNTHESIS"
    ],
    "device": "xc7vx485t",
    "fasm2netlist": "{builds}/fasm2netlist/fasm2netlist",
    "incdirs": [
    ],
    "lvs_equiv": "{builds}/fasm2netlist/lvs_equiv",
    "name": "johnson",
    "nextpnr": "{builds}/nextpnr/nextpnr-himbaechel",
    "nextpnr_flags": "--router router2 --timing-allow-fail -o hold-fix --placer-heap-timingweight 60",
    "openfpgaloader": "{prefix}/bin/openFPGALoader",
    "part": "xc7vx485tffg1761-2",
    "prjxray_db": "{deps}/prjxray-db",
    "python": "{builds}/venv/bin/python",
    "sources": [
        "{root}/projects/johnson-src/top.v",
        "{root}/projects/johnson-src/counter25_core.v"
    ],
    "srcdir": "{root}/projects/johnson-src",
    "sta": "{prefix}/bin/sta",
    "steps": [
        {
            "command": "MEM_INIT_DIR={srcdir} VERILATOR_ROOT={verilator_root} {verilator} -Wno-fatal --quiet -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-MULTIDRIVEN -Wno-BLKANDNBLK -Wno-PINMISSING -Wno-UNOPTFLAT -Wno-TIMESCALEMOD {defines} {incdirs} --top-module {top} --struct-only-report {blackboxes} --map-only-output {json} --map-only-verilog {work}/{top}_mapped.v --map-only-edif {edif} --Mdir {work}/obj {xilinx_stubs} {sources}",
            "id": "synth",
            "label": "Synthesize"
        },
        {
            "command": "{nextpnr} --device {part} -o xdc={xdc} --json {json} -o fasm={fasm} -o placement={placement} --write {routed} --sdf {sdf} {nextpnr_flags}",
            "id": "pnr",
            "label": "Place & Route"
        },
        {
            "command": "python3 {sta_prep} --json {routed} --sdf {sdf} --log {work}/pnr.log --out {work}/sta && cd {work}/sta && {sta} -no_splash -exit sta.tcl",
            "id": "sta",
            "label": "OpenSTA"
        },
        {
            "command": "{fasm2netlist} --fasm {fasm} --db {prjxray_db} --family virtex7 --device {device} --out {work}/{top}_gates.v --xdc {xdc} --part {part} && {lvs_equiv} --gold {work}/{top}_mapped.v --gate {work}/{top}_gates.v --top {top}",
            "id": "lvs",
            "label": "LVS"
        },
        {
            "command": "{python} {convert} --arch xilinx --family xc7 --part {part} --db {prjxray_db} --fasm {fasm} --output {bit}",
            "id": "bit",
            "label": "Bitstream"
        },
        {
            "command": "{openfpgaloader} --cable digilent --freq 15000000 {bit}",
            "id": "program",
            "label": "Program"
        }
    ],
    "top": "top",
    "verilator": "{prefix}/bin/verilator",
    "verilator_root": "{prefix}/share/verilator",
    "work": "~/synthgui-work/johnson",
    "xdc": "{root}/projects/johnson-src/top.xdc",
    "xilinx_stubs": "{root}/xc7/cells_sim.v {root}/xc7/cells_xtra.v"
}
