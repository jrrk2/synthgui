<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows package (.github/workflows/windows-release.yml): paste it into the
  SignPath project's artifact configuration. The artifact is the package folder, zipped by actions/upload-artifact, so
  its root holds bin/, build-deps/, deps/, projects/ ...

  Only synthgui's own program is signed, with the converters (tools/) built into it: SignPath Foundation signs a
  project's own binaries. The tools from other projects (verilator, nextpnr, OpenSTA, prjxray, openFPGALoader) and
  the MINGW64 and Qt DLLs are bundled unsigned, which its terms allow. fasm2netlist (tileverilog, lvs_equiv) is
  jrrk2's own project too; add it here if SignPath agrees that it counts as part of this one.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="bin/synthgui.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
